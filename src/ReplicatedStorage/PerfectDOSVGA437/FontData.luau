local FontData = {
	AtlasImage = "rbxassetid://113835971694569",
	AtlasSize = Vector2.new(512, 256),
	CellSize = Vector2.new(16, 16),
	GlyphSize = Vector2.new(9, 16),
	Advance = 9,
	LineHeight = 16,
	Columns = 32,
	FallbackCodepoint = 0x003F,
	GlyphIndex = GlyphIndex,
}

function FontData.GetRect(codepoint: number): (Vector2, Vector2)
	local index = GlyphIndex[codepoint]
	if index == nil then
		index = GlyphIndex[FontData.FallbackCodepoint]
	end

	local column = index % FontData.Columns
	local row = math.floor(index / FontData.Columns)

	return Vector2.new(
		column * FontData.CellSize.X,
		row * FontData.CellSize.Y
	), FontData.GlyphSize
end

return FontData
