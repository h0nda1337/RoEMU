local function splitLines(text)
	local result = {}
	text = text:gsub("\r\n", "\n"):gsub("\r", "\n")
	for line in (text .. "\n"):gmatch("(.-)\n") do
		table.insert(result, line)
	end
	return result
end

function Logo.Center(text, columns)
	assert(type(text) == "string", "text must be a string")
	columns = math.max(1, math.floor(tonumber(columns) or Logo.Width))

	local centered = {}
	for _, line in ipairs(splitLines(text)) do
		local width = utf8.len(line) or #line
		local left = math.max(0, math.floor((columns - width) / 2))
		table.insert(centered, string.rep(" ", left) .. line)
	end
	return table.concat(centered, "\n")
end

function Logo.Get(columns, logoOnly)
	local text = logoOnly and Logo.LogoOnly or Logo.Raw
	if columns then
		return Logo.Center(text, columns)
	end
	return text
end

return Logo

